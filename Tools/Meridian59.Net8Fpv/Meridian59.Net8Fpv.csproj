<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>Meridian59.Net8Fpv</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The renderer is shared with MobileClient so this checks the code
         that actually ships, not a copy of it. -->
    <Compile Include="../../MobileClient/Renderer.cs" Link="Renderer.cs" />
    <Compile Include="../../MobileClient/M59Grass.cs" Link="M59Grass.cs" />
    <Compile Include="../../MobileClient/M59Sky.cs" Link="M59Sky.cs" />
    <Compile Include="../../MobileClient/M59Png.cs" Link="M59Png.cs" />
    <Compile Include="../../MobileClient/M59Water.cs" Link="M59Water.cs" />
    <Compile Include="../../MobileClient/WaterNoise.cs" Link="WaterNoise.cs" />
    <Compile Include="../../MobileClient/M59Geo.cs" Link="M59Geo.cs" />
    <Compile Include="../../MobileClient/WallGrid.cs" Link="WallGrid.cs" />
    <Compile Include="../../MobileClient/FlatAnchors.cs" Link="FlatAnchors.cs" />
    <ProjectReference Include="../../Meridian59/net8.csproj" />
  </ItemGroup>
</Project>
