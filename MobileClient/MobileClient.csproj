<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- Godot's Android export template embeds a .NET 9 runtime and
         refuses assemblies built for anything else, while the desktop
         templates are happy with net8.0. An MSBuild condition is no use
         here: Godot reads this element out of the XML rather than
         evaluating the project, so it would only ever see the first
         value. The Android build script rewrites this line to net9.0
         and puts it back afterwards. -->
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <!-- The composer writes pixels through the library's own scaler, which
         takes a uint* buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MobileClient</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meridian59/net8.csproj" />
  </ItemGroup>
</Project>
