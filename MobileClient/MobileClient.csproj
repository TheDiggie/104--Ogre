<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- Godot's Android export template embeds a .NET 9 runtime and
         refuses assemblies built for anything else, while the desktop
         templates are happy with net8.0 and the rest of this repo
         builds against it. Godot sets GodotTargetPlatform when it
         publishes, so the platform picks the framework and nothing has
         to be edited per build. An unconditioned element has to come
         first or Godot writes one in for you; the later matching one
         wins, which is MSBuild's own rule. -->
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <!-- The composer writes pixels through the library's own scaler, which
         takes a uint* buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MobileClient</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meridian59/net8.csproj" />
  </ItemGroup>
</Project>
