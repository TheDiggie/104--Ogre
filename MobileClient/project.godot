; Meridian 59 mobile client - Godot 4 (.NET)
; Engine configuration file.

config_version=5

[application]

config/name="Meridian 59 Mobile"
; Read at runtime by M59Paths.PackStamp, and the marker that says the
; bundled game data has been unpacked carries it. Bump this whenever the
; resource folder that ships in the APK changes and every device that
; already has the old data will replace it on the next launch; leave it
; and a changed pack still replaces itself, because the stamp carries the
; pack's file count and total size too. It was absent before, and the
; Android preset's version/code - which is NOT readable at runtime - was
; 1 for every build, so a new APK's resources were ignored for ever.
config/version="0.13.2"
config/icon="res://art/icon.png"
run/main_scene="res://Game.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="MobileClient"

[rendering]

renderer/rendering_method="mobile"
; Android refuses an export without it: "ETC2/ASTC texture compression is
; required for Android export". Nothing here actually ships a compressed
; texture - every wall and sprite is rasterised into a buffer at runtime
; from the game's own art - but the check is on the setting, not on what
; the project contains.
textures/vram_compression/import_etc2_astc=true
